def run_sim(target="fifo"):
    target = target.lower()
    print(f"\n{BOLD}▶ Running Simulation Target: {CYAN}{target.upper()}{RESET}...")
    if target == "axis":
        cmd = ["make", "clean"]
        subprocess.run(cmd, cwd=DEMO_DIR)
        cmd = [
            "make", "SIM=verilator",
            "TOPLEVEL=axis_fifo",
            "MODULE=test_axis_fifo",
            f"VERILOG_SOURCES={DEMO_DIR}/axis_fifo.sv"
        ]
    elif target == "icarus":
        cmd = ["make", "clean"]
        subprocess.run(cmd, cwd=DEMO_DIR)
        cmd = ["make", "SIM=icarus"]
    else:
        cmd = ["make", "clean"]
        subprocess.run(cmd, cwd=DEMO_DIR)
        cmd = ["make", "SIM=verilator"]

    res = subprocess.run(cmd, cwd=DEMO_DIR)
    if res.returncode == 0:
        print(f"\n{GREEN}✔ Simulation '{target}' completed successfully with ZERO errors!{RESET}")
    else:
        print(f"\n{RED}✘ Simulation '{target}' failed. Check logs above.{RESET}")
    return res.returncode


def run_sv(target="run"):
    print(f"\n{BOLD}▶ Running Pure SystemVerilog IEEE 1800 OOP Testbench Target: {CYAN}{target.upper()}{RESET}...")
    sys.path.insert(0, AGENT_ROOT)
    import vlsi_mcp
    res = vlsi_mcp.run_sv_testbench(SV_DIR, target=target)
    print(res)


def gen_sv(module_name="my_design", out_dir=None):
    print(f"\n{BOLD}▶ Scaffolding Complete IEEE 1800 SV Layered OOP Testbench for: {CYAN}{module_name}{RESET}...")
    sys.path.insert(0, AGENT_ROOT)
    import vlsi_mcp
    if not out_dir:
        out_dir = f"sv_{module_name.lower()}_tb"
    res = vlsi_mcp.generate_sv_layered_tb(module_name, output_dir=out_dir)
    print(res)


def run_formal():
    print(f"\n{BOLD}▶ Running Formal Invariant Verification via Yosys SAT...{RESET}")
    sys.path.insert(0, AGENT_ROOT)
    import vlsi_mcp
    fifo_sv = os.path.join(DEMO_DIR, "fifo.sv")
    res = vlsi_mcp.run_formal_check(fifo_sv, top_module="fifo", property_check="count <= 16")
    print(res)


def run_lec():
    print(f"\n{BOLD}▶ Running Formal Logic Equivalence Checking (LEC)...{RESET}")
    sys.path.insert(0, AGENT_ROOT)
    import vlsi_mcp
    fifo_sv = os.path.join(DEMO_DIR, "fifo.sv")
    res = vlsi_mcp.check_logic_equivalence(fifo_sv, fifo_sv, top_module="fifo")
    print(res)


def run_mutate():
    print(f"\n{BOLD}▶ Running Mutation Testing & Fault Grading...{RESET}")
