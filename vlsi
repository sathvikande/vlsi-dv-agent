def test_mcp():
    print(f"\n{BOLD}▶ Testing MCP Server (vlsi_tools)...{RESET}")
    subprocess.run(["hermes", "mcp", "test", "vlsi_tools"])


def show_manual():
    if os.path.isfile(MANUAL_PATH):
        with open(MANUAL_PATH) as f:
            print(f.read())
    else:
        print(f"{RED}Manual not found at {MANUAL_PATH}. Run 'vlsi update-manual' to generate it.{RESET}")


def update_manual():
    print(f"\n{BOLD}▶ Auto-Synchronizing USER_MANUAL.md with registered tools in vlsi_mcp.py...{RESET}")
    sys.path.insert(0, AGENT_ROOT)
    import vlsi_mcp
    res = vlsi_mcp.update_user_manual(MANUAL_PATH)
    print(res)


def backup_context():
    print(f"\n{BOLD}▶ Backing up complete conversation context window...{RESET}")
    script_path = os.path.join(AGENT_ROOT, "context_backup", "export_context.py")
    subprocess.run(["python3.14", script_path])


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ["-h", "--help", "help"]:
        show_help()
        sys.exit(0)

    cmd = sys.argv[1].lower()

    if cmd in ["run", "demo"]:
        print_banner()
        print(f"\n{BOLD}🚀 EXECUTING COMPLETE END-TO-END VERIFICATION SUITE{RESET}\n")
        # Step 1: Pure SystemVerilog Layered OOP Testbench
        run_sv("run")
        # Step 2: Core FIFO SVA Simulation
        rc = run_sim("fifo")
        if rc != 0: sys.exit(rc)
        # Step 3: AXI VIP
        rc = run_sim("axis")
        if rc != 0: sys.exit(rc)
        # Step 4: LEC
        run_lec()
        # Step 5: Mutation
        run_mutate()
        # Step 6: Dashboard
        run_dashboard()
        print(f"\n{GREEN}{BOLD}🎉 ALL DEMO PASSES COMPLETED SUCCESSFULLY!{RESET}\n")

    elif cmd in ["sv", "sim-sv"]:
        target = sys.argv[2] if len(sys.argv) > 2 else "run"
        run_sv(target)

    elif cmd in ["gen-sv", "gensv"]:
        mod = sys.argv[2] if len(sys.argv) > 2 else "my_design"
        out = sys.argv[3] if len(sys.argv) > 3 else None
        gen_sv(mod, out)

    elif cmd == "sim":
        target = sys.argv[2] if len(sys.argv) > 2 else "fifo"
        run_sim(target)

    elif cmd == "formal":
        run_formal()

    elif cmd == "lec":
        run_lec()

    elif cmd in ["mutate", "mutation"]:
        run_mutate()

    elif cmd in ["dashboard", "ucdb"]:
        run_dashboard()

    elif cmd in ["heal", "self-heal"]:
        run_heal()

    elif cmd in ["agent", "chat"]:
        run_agent()

    elif cmd in ["test-mcp", "mcp"]:
        test_mcp()

    elif cmd in ["manual", "doc", "docs"]:
        show_manual()

    elif cmd in ["update-manual", "sync-docs"]:
        update_manual()

    elif cmd in ["save-context", "backup-context", "export-context"]:
        backup_context()

    else:
        print(f"{RED}Unknown command: '{cmd}'{RESET}")
        show_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
